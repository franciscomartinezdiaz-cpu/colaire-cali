# ===== ColAIre · claves y canales =====
# Copia este archivo como .env (los scripts de inicio lo hacen solos) y completa lo que tengas.

# Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram (opcional): crea un bot con @BotFather y pega su token
TELEGRAM_BOT_TOKEN=
# chat_id del grupo "Sala de crisis" (número negativo, ver README)
TELEGRAM_CHAT_DEFAULT=
# Opcional: un grupo por entidad (si lo dejas vacío, todo va al grupo general)
TELEGRAM_CHAT_SALUD=
TELEGRAM_CHAT_BOMBEROS=
TELEGRAM_CHAT_RIESGO=
TELEGRAM_CHAT_ALCALDIA=
TELEGRAM_CHAT_GOBERNACION=
TELEGRAM_CHAT_CRUZROJA=
TELEGRAM_CHAT_DEFENSACIVIL=
TELEGRAM_CHAT_MOVILIDAD=
TELEGRAM_CHAT_POLICIA=

# ===== Semáforos dañados (correo con Gmail desde n8n) =====
CORREO_JHINNA=
# Opcional: más destinatarios separados por coma
CORREO_SEMAFOROS_COPIA=
